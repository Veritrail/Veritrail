    "control_id": "COMPOSITE.MDM_ENDPOINT",
    "title": "Device Management (MDM)",
    "description": "Corporate device enrollment, encryption, and compliance live outside AWS. Veritrail cannot verify MDM from cloud posture alone — connect Intune or Jamf for supplemental device sync, and upload accepted manual evidence for audit.",
