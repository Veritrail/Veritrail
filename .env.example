POSTGRES_USER=hygiene
POSTGRES_PASSWORD=hygiene
POSTGRES_DB=hygiene

APP_ENV=dev
APP_SECRET=change-me-long-random
JWT_SECRET=change-me-long-random
# Fernet key for role_arn / external_id at rest (required when APP_ENV != dev)
ENCRYPTION_KEY=
# AUTH_ACCESS_TOKEN_HOURS=24
# AUTH_REFRESH_REMEMBER_DAYS=30
# AUTH_REFRESH_SESSION_HOURS=24

# Principal in the CFN stack trust policy (prod control plane or your SSO role ARN for local dev).
# Local Docker uses ~/.aws (SSO). Do not set empty AWS_PROFILE/AWS_* in .env — use the mount only.
TRUST_PRINCIPAL_ARN=arn:aws:iam::000000000000:root

# Public URL of API (used to build CFN ExternalId callbacks if needed)
API_PUBLIC_URL=http://localhost:8000
# Local Trust Center logo files (dev). Mounted to ./data/uploads in compose.
LOCAL_UPLOAD_DIR=data/uploads
FRONTEND_URL=http://localhost:5173
# Leave empty to use Vite /v1 proxy (same-origin cookies in dev). Or set http://localhost:8000.
VITE_API_URL=
# Optional: public web origin for copied links (defaults to browser origin in dev)
VITE_FRONTEND_URL=http://localhost:5173

# GitHub OAuth (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Defaults to the existing GitHub login callback so one OAuth App registration can handle both login and evidence integration.
GITHUB_INTEGRATION_CALLBACK_PATH=/v1/auth/github/callback

# Google OAuth (login — separate from Workspace identity integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Restrict Google sign-in to one domain (e.g. cloud-castles.com). Leave blank to allow any Google account.
GOOGLE_ALLOWED_DOMAIN=

# Prod hostnames (set by bootstrap-ec2.sh; required for oauth2-proxy redirect URL).
DOMAIN=
API_DOMAIN=

# Edge IAP gate (prod nginx + oauth2-proxy) — blocks all traffic until Google sign-in.
# Separate OAuth client recommended; redirect URI: https://<your-web-domain>/oauth2/callback
IAP_ENABLED=false
IAP_ALLOWED_EMAIL_DOMAIN=cloud-castles.com
IAP_GOOGLE_CLIENT_ID=
IAP_GOOGLE_CLIENT_SECRET=
# 32-byte base64 secret for oauth2-proxy session cookie (auto-generated by bootstrap-ec2.sh)
IAP_COOKIE_SECRET=
# Share session across web + API hosts (e.g. .cclab.cloud-castles.com)
IAP_COOKIE_DOMAIN=
IAP_WHITELIST_DOMAINS=

# Google Workspace Admin Directory (identity evidence — separate OAuth app from login)
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_INTEGRATION_CALLBACK_PATH=/v1/integrations/google-workspace/callback

# Microsoft Entra ID directory read (identity evidence)
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_INTEGRATION_CALLBACK_PATH=/v1/integrations/entra/callback

# GitLab OAuth (login + integrations — add both callback URLs to your GitLab app)
GITLAB_CLIENT_ID=
GITLAB_CLIENT_SECRET=
# Login callback: {API_PUBLIC_URL}/v1/auth/gitlab/callback
# Integration callback: {API_PUBLIC_URL}/v1/integrations/gitlab/callback
GITLAB_INTEGRATION_CALLBACK_PATH=/v1/integrations/gitlab/callback

# Email (SMTP) — auditor invites, team invites, digests, password reset, alerts.
# Gmail: smtp.gmail.com:587 + app password from https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=

# Optional: Ed25519 signing for evidence pack checksum manifests (base64url 32-byte seed).
# Generate: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
EVIDENCE_PACK_SIGNING_KEY=

# Immutable evidence vault (S3 Object Lock). Key layout: {prefix}/{APP_ENV}/{aws_account_id}/{date}/{report_id}.zip
# Set true when vigil-worm-storage bucket is deployed with Object Lock + versioning
EVIDENCE_VAULT_ENABLED=true
EVIDENCE_VAULT_S3_URI=s3://vigil-worm-storage/vigil
EVIDENCE_VAULT_S3_REGION=us-east-1
EVIDENCE_VAULT_OBJECT_LOCK_MODE=COMPLIANCE
EVIDENCE_VAULT_RETENTION_DAYS=365
# none | presigned (time-limited GET for auditors)
EVIDENCE_VAULT_AUDITOR_ACCESS_MODE=none

# CloudFormation console deep-link region (customer connector stack deploy/update).
CFN_CONSOLE_REGION=us-east-1

# Customer-facing CloudFormation templates — publicly readable by CloudFormation in customer accounts.
# Upload from infra/cfn/ to amzn-s3-vigil (Content-Type: text/plain or text/yaml for browser "View template").
# vigil-worm-storage is evidence vault only.
# Parent stack + nested children (paths must match your S3 key prefix):
CFN_TEMPLATE_URL=https://amzn-s3-vigil.s3.us-east-1.amazonaws.com/infra/vigil-stack.yaml
CFN_REMEDIATION_TEMPLATE_URL=https://amzn-s3-vigil.s3.us-east-1.amazonaws.com/infra/2026.06/vigil-remediation-ssm.yaml
CFN_REMEDIATION_SSM_TEMPLATE_URL=https://amzn-s3-vigil.s3.us-east-1.amazonaws.com/infra/2026.06/vigil-remediation-ssm.yaml

# Customer SSM Automation — region where the remediation document lives.
REMEDIATION_AUTOMATION_REGION=us-east-1
REMEDIATION_SSM_DOCUMENT_NAME=Vigil-RemediationPlanExecutor
REMEDIATION_PLAN_TTL_MINUTES=60

# When false, OAuth login only links to existing users — no new org signup via GitHub/GitLab/Google.
# Set false before production (invite-only social login). Dev may use true for solo testing.
ALLOW_SSO_SIGNUP=False

# AI-assisted finding triage (LLM-powered classification of findings).
# When false, no triage runs and no AI UI shows.  When true, configure the
# API endpoint + key below (any OpenAI-compatible provider works).
AI_TRIAGE_ENABLED=False
AI_TRIAGE_API_URL=https://api.openai.com
AI_TRIAGE_API_KEY=
AI_TRIAGE_MODEL=gpt-4o-mini
