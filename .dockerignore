# Keep host trees out of the Docker build context — especially web/node_modules,
# which overwrites `npm ci` and breaks vite (exit 126 / permission denied).
.git
.github
**/.git

web/node_modules
web/dist
**/node_modules
**/.npm

api/**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache

.env
.env.*
!.env.example

var/
data/
examples/
*.md
!api/**/*.md
!web/**/*.md
