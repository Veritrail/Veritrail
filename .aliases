# Veritrail shell shortcuts — source from the repo root:
#   source .aliases
#
# h — one-time Hetzner bootstrap (Vault PKI + IAM Roles Anywhere); needs AWS account/credentials
# d — routine prod redeploy (git pull + migrate + compose rebuild); no AWS credentials required

alias h='git pull && EMAIL=zenmyx@gmail.com ENV_FILE=.env.prod DOMAIN=app.veritrail.io API_DOMAIN=api.veritrail.io ./scripts/launch-prod.sh --hetzner-roles-anywhere'
alias d='EMAIL=zenmyx@gmail.com ENV_FILE=.env.prod DOMAIN=app.veritrail.io API_DOMAIN=api.veritrail.io ./scripts/launch-prod.sh --deploy-only --git-pull'
