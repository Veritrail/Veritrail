{
  "family": "veritrail-beat",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "__EXECUTION_ROLE_ARN__",
  "taskRoleArn": "__TASK_ROLE_ARN__",
  "containerDefinitions": [
    {
      "name": "beat",
      "image": "__API_IMAGE__",
      "essential": true,
      "command": ["celery", "-A", "app.worker.celery_app", "beat", "--loglevel=info"],
      "secrets": [{ "name": "APP_CONFIG", "valueFrom": "__APP_SECRET_ARN__" }],
      "environment": [
        { "name": "AWS_DEFAULT_REGION", "value": "__AWS_REGION__" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/veritrail-beat",
          "awslogs-region": "__AWS_REGION__",
          "awslogs-stream-prefix": "beat"
        }
      }
    }
  ]
}
